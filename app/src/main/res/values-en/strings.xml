    <string name="privacy_read_title">Read photos</string>
    <string name="privacy_read_desc">LumaDepth can only read photos you actively choose through the system photo picker. It cannot browse or read other content in your gallery.</string>
    <string name="privacy_write_title">Save photos</string>
    <string name="privacy_write_desc">LumaDepth only adds the results you actively export to the system gallery. It never modifies or deletes existing photos.</string>
